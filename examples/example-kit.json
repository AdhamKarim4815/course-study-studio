  "practice": [
    {
      "id": "p1",
      "title": "A bake sale table",
      "source": "Fictional",
      "minutes": 8,
      "context": "A club sells cookies at **$1.50** each. Ingredients and packaging cost **$0.40** a cookie, and the table fee and flyers cost **$88**.",
      "parts": [
        {
          "q": "What is the contribution margin per cookie?",
          "marks": 1,
          "answer": "$1.50 − $0.40 = **$1.10**",
          "lesson": "break-even"
        },
        {
          "q": "How many cookies must the club sell to break even?",
          "marks": 2,
          "answer": "$88 ÷ $1.10 = **80 cookies**",
          "lesson": "break-even"
        },
        {
          "q": "What is the profit if it sells 120 cookies?",
          "marks": 2,
          "answer": "120 × $1.10 − $88 = **$44**",
          "lesson": "break-even"
        }
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "group": "CVP analysis",
      "q": "Break-even units equal...",
      "options": [
        "Fixed costs ÷ price",
        "Fixed costs ÷ CM per unit",
        "Variable cost ÷ CM ratio",
        "Sales ÷ fixed costs"
      ],
      "answer": 1,
      "why": "Each unit contributes its CM toward fixed costs, so divide fixed costs by the CM per unit.",
      "lesson": "break-even"
    },
    {
      "id": "q2",
      "group": "CVP analysis",
      "q": "The price rises and costs stay the same. Break-even units...",
      "options": [
        "Rise",
        "Fall",
        "Stay the same",
        "Can't tell"
      ],
      "answer": 1,
      "why": "A higher price raises the CM per unit, so fewer units cover the same fixed costs.",
      "lesson": "break-even"
    }
  ],
