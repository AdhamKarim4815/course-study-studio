  "lessons": [
    {
      "id": "break-even",
      "group": "CVP analysis",
      "title": "Break-even in units and dollars",
      "blurb": "What one cup leaves over, how many cups cover the fixed costs, and why you round up.",
      "source": "Fictional example written for this repository.",
      "fictional": true,
      "table": {
        "title": "Sunny Cup lemonade, one month (fictional)",
        "headers": [
          "Item",
          "Amount"
        ],
        "rows": [
          [
            "Price per cup",
            "$2.50"
          ],
          [
            "Variable cost per cup",
            "$0.70"
          ],
          [
            "Fixed costs per month",
            "$460"
          ]
        ],
        "derived": []
      },
      "lines": [
        {
          "id": "f-cm",
          "kind": "formula",
          "always": true,
          "parts": [
            {
              "f": "tcm",
              "text": "CM per unit"
            },
            " = price − variable cost"
          ]
        },
        {
          "id": "f-be",
          "kind": "formula",
          "always": true,
          "parts": [
            {
              "f": "tbe",
              "text": "Break-even units"
            },
            " = fixed costs ÷ CM per unit"
          ]
        },
        {
          "id": "h1",
          "kind": "head",
          "parts": [
            "A. What one cup leaves over"
          ]
        },
        {
          "id": "l-cm",
          "kind": "eq",
          "label": "CM per cup",
          "parts": [
            {
              "s": "p",
              "ph": "price"
            },
            " − ",
            {
              "s": "v",
              "ph": "VC"
            },
            " = ",
            {
              "s": "cm",
              "ph": "CM"
            }
          ]
        },
        {
          "id": "l-ratio",
          "kind": "eq",
          "label": "CM ratio",
          "parts": [
            {
              "s": "cm2",
              "ph": "CM"
            },
            " ÷ ",
            {
              "s": "p2",
              "ph": "price"
            },
            " = ",
            {
              "s": "ratio",
              "ph": "ratio"
            }
          ]
        },
        {
          "id": "h2",
          "kind": "head",
          "parts": [
            "B. Break-even"
          ]
        },
        {
          "id": "l-beu",
          "kind": "eq",
          "label": "Break-even units",
          "parts": [
            {
              "s": "f",
              "ph": "fixed"
            },
            " ÷ ",
            {
              "s": "cm3",
              "ph": "CM"
            },
            " = ",
            {
              "s": "beu",
              "ph": "cups"
            }
          ]
        },
        {
          "id": "l-round",
          "kind": "total",
          "label": "Round up",
          "parts": [
            "→ ",
            {
              "s": "beu2",
              "ph": "cups"
            },
            " a month"
          ]
        },
        {
          "id": "l-bes",
          "kind": "eq",
          "label": "Break-even sales",
          "parts": [
            {
              "s": "f2",
              "ph": "fixed"
            },
            " ÷ ",
            {
              "s": "r2",
              "ph": "ratio"
            },
            " = ",
            {
              "s": "bes",
              "ph": "sales"
            }
          ]
        }
      ],
      "steps": [
        {
          "say": "Sunny Cup sells lemonade for **$2.50** a cup. Each cup costs **$0.70** in lemons, sugar and the cup, and the stand costs **$460** a month to run. These numbers are made up.",
          "hl": [
            "0.1",
            "1.1",
            "2.1"
          ]
        },
        {
          "say": "First: how much does one cup leave over after paying for its own ingredients?",
          "show": [
            "h1",
            "l-cm"
          ],
          "focus": [
            "tcm"
          ]
        },
        {
          "say": "Price minus variable cost per cup.",
          "fly": [
            {
              "from": "0.1",
              "to": "p"
            },
            {
              "from": "1.1",
              "to": "v"
            }
          ]
        },
        {
          "say": "$2.50 − $0.70 = **$1.80**: the **contribution margin** per cup, what each cup adds toward fixed costs and then profit.",
          "calc": {
            "cm": "$1.80"
          }
        },
        {
          "say": "As a share of the price, that $1.80 is the CM ratio.",
          "show": [
            "l-ratio"
          ],
          "fly": [
            {
              "from": "@cm",
              "to": "cm2"
            },
            {
              "from": "0.1",
              "to": "p2"
            }
          ]
        },
        {
          "say": "$1.80 ÷ $2.50 = **72%**: 72 cents of every sales dollar is left after variable costs.",
          "calc": {
            "ratio": "72%"
          }
        },
        {
          "say": "Now: how many $1.80 contributions does it take to cover $460 of fixed costs?",
          "show": [
            "h2",
            "l-beu"
          ],
          "focus": [
            "tbe"
          ],
          "fly": [
            {
              "from": "2.1",
              "to": "f"
            },
            {
              "from": "@cm",
              "to": "cm3"
            }
          ],
          "reveal": [
            "fixed"
          ]
        },
        {
          "say": "$460 ÷ $1.80 = **255.56** cups.",
          "calc": {
            "beu": "255.56"
          }
        },
        {
          "say": "You can't sell part of a cup, and 255 cups leave a $1.00 loss, so round **up**: **256 cups** a month.",
          "calc": {
            "beu2": "256"
          },
          "reveal": [
            "be"
          ]
        },
        {
          "say": "In sales dollars, divide fixed costs by the CM ratio: $460 ÷ 72% = **$638.89**.",
          "show": [
            "l-bes"
          ],
          "fly": [
            {
              "from": "2.1",
              "to": "f2"
            },
            {
              "from": "@ratio",
              "to": "r2"
            }
          ],
          "calc": {
            "bes": "$638.89"
          }
        },
        {
          "say": "On the graph, sales and total costs cross at break-even: losses to the left, profit to the right.",
          "reveal": [
            "sales",
            "cost"
          ]
        }
      ],
      "chart": {
        "title": "Sunny Cup: sales and total costs",
        "x": {
          "label": "Cups sold",
          "min": 0,
          "max": 400,
          "ticks": [
            0,
            100,
            200,
            300,
            400
          ],
          "fmt": "n"
        },
        "y": {
          "label": "Dollars",
          "min": 0,
          "max": 1000,
          "ticks": [
            0,
            250,
            500,
            750,
            1000
          ],
          "fmt": "$"
        },
        "layers": [
          {
            "id": "fixed",
            "kind": "hline",
            "y": 460,
            "label": "Fixed costs",
            "tone": "muted"
          },
          {
            "id": "be",
            "kind": "vline",
            "x": 255.56,
            "label": "Break-even: 256 cups",
            "tone": "hl"
          },
          {
            "id": "sales",
            "kind": "line",
            "points": [
              [
                0,
                0
              ],
              [
                400,
                1000
              ]
            ],
            "label": "Sales",
            "tone": "info"
          },
          {
            "id": "cost",
            "kind": "line",
            "points": [
              [
                0,
                460
              ],
              [
                400,
                740
              ]
            ],
            "label": "Total costs",
            "tone": "bad"
          }
        ]
      },
      "trap": "Dividing fixed costs by the price ($460 ÷ $2.50 = 184 cups) ignores what each cup costs, so it understates break-even.",
      "words": {
        "prompt": "Say it in words: why round 255.56 cups up to 256 and not down to 255?",
        "answer": "At 255 cups the stand earns $459 of contribution, $1.00 short of the $460 fixed costs, so it still loses money. Break-even needs every fixed dollar covered, so round up."
      },
